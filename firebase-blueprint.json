{
  "entities": {
    "Center": {
      "title": "Center",
      "description": "Trung tâm dạy thêm / cơ sở thuộc hệ thống Đa Trung Tâm (Chỉ lưu metadata, không chứa mảng phình to)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "suspended"] },
        "packagePlan": { "type": "string", "enum": ["Basic", "Standard", "Premium", "Enterprise"] },
        "expiryDate": { "type": "string" },
        "adminUid": { "type": "string" },
        "adminUsername": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "GlobalUser": {
      "title": "GlobalUser",
      "description": "Tài khoản toàn hệ thống hỗ trợ đăng nhập và điều hướng Trung tâm",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "center_admin", "teacher", "parent"] },
        "centerId": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Lớp học thuộc sub-collection /centers/{centerId}/classes/{classId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "classCode": { "type": "string" },
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherPhone": { "type": "string" },
        "room": { "type": "string" },
        "schedule": { "type": "string" },
        "studentCount": { "type": "number" },
        "maxCapacity": { "type": "number" },
        "pricePerSession": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "paused"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "centerId", "name", "subject"]
    },
    "User": {
      "title": "User",
      "description": "Tài khoản người dùng (Center Admin, Giáo viên, Phụ huynh) thuộc sub-collection của một trung tâm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "centerId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "username": { "type": "string" },
        "mainClassId": { "type": "string" },
        "mainClassName": { "type": "string" }
      }
    },
    "Student": {
      "title": "Student",
      "description": "Học sinh thuộc sub-collection /centers/{centerId}/students/{studentId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "studentCode": { "type": "string" },
        "name": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "attendanceStatus": { "type": "string", "enum": ["present", "absent", "excused", "unexcused"] },
        "gpa": { "type": "number" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Phiên điểm danh theo buổi học thuộc sub-collection /centers/{centerId}/attendance/{attendanceId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "date": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "sessionNote": { "type": "string" },
        "records": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "centerId", "classId", "date"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Bài tập thuộc sub-collection /centers/{centerId}/assignments/{assignmentId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "dueDate": { "type": "string" },
        "assignedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["working", "completed", "grading", "graded"] },
        "maxScore": { "type": "number" },
        "attachedFileUrl": { "type": "string" },
        "storagePath": { "type": "string" }
      },
      "required": ["id", "centerId", "title", "classId"]
    },
    "AssignmentSubmission": {
      "title": "AssignmentSubmission",
      "description": "Bài nộp của học sinh thuộc sub-collection /centers/{centerId}/assignments/{assignmentId}/submissions/{submissionId}",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "submittedAt": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "graded"] },
        "score": { "type": "number" },
        "feedback": { "type": "string" }
      },
      "required": ["id", "assignmentId", "studentId", "fileUrl"]
    },
    "RenewalRequest": {
      "title": "RenewalRequest",
      "description": "Yêu cầu gia hạn bản quyền từ Center Admin gửi đến Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centerId": { "type": "string" },
        "centerName": { "type": "string" },
        "centerCode": { "type": "string" },
        "months": { "type": "number", "enum": [3, 6, 12] },
        "amount": { "type": "number", "enum": [199000, 399000, 599000] },
        "price": { "type": "number", "enum": [199000, 399000, 599000] },
        "memo": { "type": "string" },
        "bankId": { "type": "string" },
        "accountNo": { "type": "string" },
        "accountName": { "type": "string" },
        "packageLabel": { "type": "string" },
        "contactPhone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAtStr": { "type": "string" }
      },
      "required": ["id", "centerId", "months", "price", "memo", "contactPhone"]
    }
  },
  "firestore": {
    "/centers/{centerId}": {
      "schema": { "$ref": "#/entities/Center" },
      "description": "Document trung tâm chỉ lưu metadata định danh và hạn bản quyền (không chứa mảng phình to)"
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/GlobalUser" },
      "description": "Root Collection Index: chứa dữ liệu định danh và định tuyến tối thiểu (uid, centerId, role, status, username, email)"
    },
    "/renewal_requests/{requestId}": {
      "schema": { "$ref": "#/entities/RenewalRequest" },
      "description": "Root Collection chứa các yêu cầu gia hạn bản quyền từ Center Admin gửi lên Super Admin"
    },
    "/centers/{centerId}/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Sub-collection người dùng thuộc trung tâm"
    },
    "/centers/{centerId}/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Sub-collection lớp học thuộc trung tâm"
    },
    "/centers/{centerId}/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Sub-collection giáo viên thuộc trung tâm"
    },
    "/centers/{centerId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Sub-collection học sinh thuộc trung tâm"
    },
    "/centers/{centerId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Sub-collection điểm danh thuộc trung tâm"
    },
    "/centers/{centerId}/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Sub-collection bài tập thuộc trung tâm"
    },
    "/centers/{centerId}/assignments/{assignmentId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AssignmentSubmission" },
      "description": "Sub-collection bài nộp của từng học sinh trong một bài tập"
    }
  }
}
